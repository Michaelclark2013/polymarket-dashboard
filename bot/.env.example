# Copy to bot/.env and edit. bot/.env is gitignored — NEVER commit real keys.

# ---- mode ----
# Leave DRY_RUN=true to paper-trade (default & recommended). Places NOTHING.
DRY_RUN=true

# ---- strategy / risk (very tight defaults shown) ----
MIN_EDGE_CENTS=1.0
EDGE_BUFFER_CENTS=0.5
MARKET_SCAN_LIMIT=150
MAX_PER_TRADE_USD=5
MAX_EXPOSURE_USD=25
DAILY_LOSS_KILL_USD=20
MAX_OPEN_POSITIONS=5
POLL_MS=15000
# ONCE=true   # uncomment to run a single scan then exit (for testing)

# ---- smart-money copy (latency-tolerant edge — mirror sharp wallets you find in the dashboard Smart $ tab) ----
# FOLLOW_WALLETS=0xwallet1,0xwallet2     # comma-separated proxy-wallet addresses to copy
# COPY_FRACTION=0.02                     # mirror 2% of the whale's USDC size (capped by MAX_PER_TRADE_USD)
# COPY_MIN_USDC=50                       # ignore whale trades smaller than this
# COPY_POLL_MS=20000

# ============================================================================
# GOING LIVE (real money) — only after paper mode proves profitable.
# Steps:
#   1) cd bot && npm i
#   2) set PRIVATE_KEY below (+ SIGNATURE_TYPE/FUNDER_ADDRESS if funds are in a Polymarket UI account)
#   3) fund the wallet with USDC.e on Polygon (+ a little MATIC for gas)
#   4) node preflight.js --set-allowance     # approves USDC + verifies readiness (NO trades)
#   5) node preflight.js                      # should print "READY"
#   6) THEN set DRY_RUN=false and CONFIRM_LIVE=I_UNDERSTAND
# Start with MAX_PER_TRADE_USD=5 and watch it for days before raising anything.
# ============================================================================
# DRY_RUN=false
# CONFIRM_LIVE=I_UNDERSTAND
# PRIVATE_KEY=0xyourprivatekeyhere
# SIGNATURE_TYPE=0          # 0 = EOA that holds the USDC; 1 = Polymarket email/magic; 2 = Polymarket browser wallet
# FUNDER_ADDRESS=           # the wallet that HOLDS the USDC (defaults to signer; set to your proxy wallet for type 1/2)
# AUTO_SET_ALLOWANCE=false  # if true, preflight will set the USDC allowance automatically
# MIN_USDC_BALANCE=0        # refuse to trade below this USDC (0 = use MAX_EXPOSURE_USD)
# CLOB_API_URL=https://clob.polymarket.com
# GAMMA_API_URL=https://gamma-api.polymarket.com
# CHAIN_ID=137
